# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                     threelane-memory · Configuration                       ║
# ╚══════════════════════════════════════════════════════════════════════════════╝
#
# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ QUICK START                                                                │
# │                                                                            │
# │  1. Copy this file:  cp .env.example .env                                 │
# │  2. Choose a chat provider below (ollama, openai, bedrock)                │
# │  3. Fill in your Neo4j credentials                                        │
# │  4. Run: threelane-memory config   ← verify everything is correct         │
# │                                                                            │
# │ SWITCHING PROVIDERS                                                        │
# │                                                                            │
# │  Ollama → OpenAI:                                                          │
# │   1. Set LLM_PROVIDER=openai                                              │
# │   2. Uncomment and fill OPENAI_API_KEY                                    │
# │   3. Run: threelane-memory config        ← check for dimension warnings   │
# │   4. Run: threelane-memory reindex ...   ← re-embed with new model        │
# │                                                                            │
# │  OpenAI → Ollama:                                                          │
# │   1. Install Ollama: brew install ollama && ollama serve                   │
# │   2. Pull models: ollama pull llama3.2:3b && ollama pull nomic-embed-text  │
# │   3. Set LLM_PROVIDER=ollama                                              │
# │   4. Run: threelane-memory config        ← check for dimension warnings   │
# │   5. Run: threelane-memory reindex ...   ← re-embed with new model        │
# │                                                                            │
# │ NOTE: Different embedding models produce different vector dimensions.      │
# │ The CLI will warn you if your Neo4j index dimension doesn't match.         │
# │ Run `threelane-memory config` after any provider change to verify.         │
# └─────────────────────────────────────────────────────────────────────────────┘

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Supported values: "ollama" (local, free) | "openai" | "bedrock"
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# ── Ollama (local) ───────────────────────────────────────────────────────────
# Used when LLM_PROVIDER=ollama
# Install: brew install ollama && ollama serve
# Models:  ollama pull llama3.2:3b && ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b                # Chat model (alternatives: mistral, gemma2)
OLLAMA_EMBED_MODEL=nomic-embed-text          # Embedding model (768-dim)

# ── OpenAI (cloud) ───────────────────────────────────────────────────────────
# Used when LLM_PROVIDER=openai
# Get your key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-api-key
# OPENAI_CHAT_MODEL=gpt-4o                  # Chat model
# OPENAI_EMBED_MODEL=text-embedding-ada-002  # Embedding model (1536-dim)

# ── AWS Bedrock ───────────────────────────────────────────────────────────────
# Used when LLM_PROVIDER=bedrock or EMBEDDING_PROVIDER=bedrock
# BEDROCK_API_KEY=your-bedrock-api-key
# AWS_REGION=us-west-2
# BEDROCK_MODEL_ID=mistral.mistral-large-2407-v1:0
# BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
# BEDROCK_MAX_RETRIES=2
# BEDROCK_RETRY_BASE_DELAY_SECONDS=2
# BEDROCK_RETRY_MAX_DELAY_SECONDS=15
# BEDROCK_MIN_REQUEST_INTERVAL_SECONDS=0.5
# BEDROCK_REQUEST_TIMEOUT_SECONDS=30
# BEDROCK_EMBED_TIMEOUT_SECONDS=30
# BEDROCK_CHAT_TIMEOUT_SECONDS=30
# LLM_TEMPERATURE=0.15
# LLM_MAX_TOKENS=4096

# ── Embedding Dimension (auto-detected) ──────────────────────────────────────
# Normally auto-set from the model name. Override only for custom models.
# Known dimensions: nomic-embed-text=768 | text-embedding-ada-002=1536 | amazon.titan-embed-text-v2:0=1024
# EMBEDDING_DIM=768

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password

# ── Retrieval Scoring Weights (optional) ──────────────────────────────────────
# WEIGHT_SIMILARITY=0.65
# WEIGHT_IMPORTANCE=0.30
# WEIGHT_RECENCY=0.05
# RECENCY_HALF_LIFE_DAYS=365
# IMPORTANCE_FLOOR=0.75

# ── Dynamic Candidate Pool (optional) ────────────────────────────────────────
# VECTOR_CANDIDATES_MIN=50
# VECTOR_CANDIDATES_MAX=500
# VECTOR_CANDIDATES_RATIO=0.02

# ── Consolidation (optional) ─────────────────────────────────────────────────
# CONSOLIDATION_AGE_DAYS=90
# CONSOLIDATION_BATCH_SIZE=50
# CONSOLIDATION_IMPORTANCE_CAP=0.3

# ── Backup (optional) ────────────────────────────────────────────────────────
# BACKUP_DIR=./backups

# ── Async Write-Ahead Buffer (optional) ─────────────────────────────────────
# Return tmp_* pending ids immediately and persist in a background worker.
# ASYNC_WRITE_ENABLED=true
# TEMP_BUFFER_MAX_AGE_SECONDS=300
# TEMP_BUFFER_MAX_SIZE=500

# ── Auth & Rate Limiting (optional) ─────────────────────────────────────────
# GOOGLE_CLIENT_ID=your-google-client-id
# REQUIRED for the network (sse) server: set a persistent, high-entropy value.
# The server refuses to start in sse mode without these because a per-process
# random default would invalidate every issued token and API-key hash on
# restart / across workers. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# OAUTH_JWT_SECRET=your-secure-random-secret
# API_KEY_HASH_SECRET=your-separate-api-key-hash-secret
# OAUTH_EXPECTED_ISSUER=https://mcp.reeve.co.in
# OAUTH_ALLOWED_REDIRECT_HOSTS=localhost,127.0.0.1,::1,reeve.co.in,www.reeve.co.in,mcp.reeve.co.in,claude.ai
# TRUSTED_PROXY_HOSTS=127.0.0.1,localhost,172.16.0.0/12
# DEV_AUTH_ENABLED=false   # NEVER enable in production; ignored when a public https issuer is set
# ADMIN_UIDS=              # comma-separated uids allowed to run graph-wide entity deduplication
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW_SECONDS=60

# ── Razorpay Billing (optional) ─────────────────────────────────────────────
# RAZORPAY_KEY_ID=rzp_live_xxx
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# RAZORPAY_PLAN_ID=plan_xxx
# RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# RAZORPAY_TOTAL_COUNT=120
# WARNING: Do not set this above ~1100 on a monthly plan.
# Values like 1200 produce end_time > year 2121 which breaks
# Razorpay UPI QR with BAD_REQUEST_ERROR end_time validation.
# WEBHOOK_MAX_BODY_BYTES=262144

# ── Geospatial Location Enrichment (optional) ───────────────────────────────
# When enabled, the first mention of a place enriches its Location node with
# coordinates (OSM Nominatim), a compact LLM "place card" describing the
# place's character ("Goa: coastal state known for beaches, nightlife..."),
# and an embedding of that card — and folds the card into the episode's
# searchable text so vibe-level queries ("somewhere with beaches") retrieve
# those memories. Best-effort: geocoder/LLM failures never block writes.
# GEO_ENRICHMENT_ENABLED=true
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# GEOCODER_USER_AGENT=reeve-memory (https://reeve.co.in)   # required by Nominatim policy
# GEOCODER_TIMEOUT_SECONDS=5
# GEOCODER_MIN_INTERVAL_SECONDS=1   # Nominatim policy: max 1 request/second
# PLACE_CARD_MAX_CHARS=400
# Retrieval geo lane: radius for "near X" queries and the similarity floor
# for "places like X" vibe matching.
# GEO_NEAR_RADIUS_KM=100
# GEO_VIBE_MIN_SIMILARITY=0.25
# Context-aware geocoding: if a place first geocodes farther than MAX_KM from the
# speaker's other known places, retry the lookup qualified by those places (so
# an ambiguous "City Palace" near a "Udaipur" memory resolves to Udaipur).
# GEO_DISAMBIGUATION_MAX_KM=250
# GEO_DISAMBIGUATION_MAX_TRIES=3

# ── Vision — image memories (optional) ──────────────────────────────────────
# A SEPARATE multimodal Bedrock model that turns an attached photo into a text
# memory at ingestion (the main chat model stays on text). EXIF GPS in photos
# is reverse-geocoded so the memory lands at the place it was taken. Empty
# (default) disables image support. Nova Lite is cheap and good at captioning;
# alternatives: us.amazon.nova-pro-v1:0, us.mistral.pixtral-large-2502-v1:0.
# BEDROCK_VISION_MODEL_ID=us.amazon.nova-lite-v1:0
# VISION_MAX_TOKENS=512
# VISION_MAX_IMAGE_BYTES=4194304

# ── Multimodal image embeddings (optional) ──────────────────────────────────
# Maps images AND text into one vector space so photos are searchable by how
# they look (image→image, text→image) via search_image_memories. Separate from
# the text embedding model. Empty = image search disabled. Image bytes are not
# stored — only the vector. Reaches images from the SDK (image_path), byte
# clients (image_base64), or MCP (image_url — server fetches, SSRF-guarded).
# BEDROCK_MULTIMODAL_EMBED_MODEL=amazon.titan-embed-image-v1
# MULTIMODAL_EMBED_DIM=1024
# IMAGE_URL_FETCH_TIMEOUT_SECONDS=10

# ── Supabase (optional) ─────────────────────────────────────────────────────
# Server-side mirror of the authenticated user's profile (email/name/avatar)
# into the Supabase `users` table using the service-role key. Both must be set
# for the sync to run; if either is empty it stays inert (no-op). Get the
# service-role key from Supabase dashboard → Settings → API → service_role.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
